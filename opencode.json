{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "haskell-flows": {
      "type": "local",
      "command": ["/Users/lattenero/.local/bin/haskell-flows-mcp"],
      "cwd": "/Users/lattenero/Projects/haskell-rules-and-mcp",
      "environment": {
        "HASKELL_PROJECT_DIR": "/Users/lattenero/Projects/haskell-rules-and-mcp/playground",
        "PATH": "/Users/lattenero/.ghcup/bin:/Users/lattenero/.local/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "enabled": true,
      "timeout": 60000
    },
    "web_search": {
      "type": "local",
      "command": ["npx", "-y", "mcp-duckduckgo"],
      "enabled": true,
      "timeout": 30000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  }
}
